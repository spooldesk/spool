__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
.venv-tools/
env/
ENV/

# Logs & backups
logs/
*.log
*.bak
*.backup
*.dump

# Tooling / editor / VCS
.git/
.gitignore
.idea/
.vscode/
.claude/
.agent-runs/
agents/
*.swp

# Docs & build files not needed at runtime
