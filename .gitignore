# Secrets — NEVER commit these
.env
.env.*
!.env.example

# Database — local data only, NEVER push
*.db
*.db-journal
*.db-shm
*.db-wal
support.db

# Whatever customers have attached to a ticket. Real people's screenshots and
# invoices; the one directory in this project that must never reach a commit.
data/

# What `make backup` writes. Customer data in a tarball; same rule as data/.
backups/

*.sqlite
*.sqlite3

# Backups
*.bak
*.backup
*.dump

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
.venv-tools/
env/
ENV/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Editor settings the team doesn't share
.claude/

# Old / legacy
*.old
src/config.py.old

# Личный чек-лист ручных шагов — аккаунты, платежи, юридические действия.
# Не для публичного репозитория.
MANUAL_STEPS.md

# The key that decrypts stored API keys. Generated beside the database when
# SECRETS_KEY is not in the environment, which on a dev checkout means the
# repository root. Committing it would put the one thing the encryption
# depends on in the same place as everything it protects.
secrets.key
**/secrets.key

# Local worker ledger, task drafts and process locks (never customer context).
/.agent-runs/

# One-off delegation context is local; retain only the public smoke example.
/agents/tasks/*.json
!/agents/tasks/orchestration-smoke.json

# Explicitly exported public landing assets.
/site/
