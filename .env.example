# Copy to .env and fill in. NEVER commit .env.

# --- Required ---
DATABASE_URL=
# PostgreSQL is required for normal installations. Compose uses host postgres;
# 127.0.0.1 is for a locally managed database when running Python directly.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=spooldesk
POSTGRES_DB=spooldesk
POSTGRES_PASSWORD=
ACCESS_PASSWORD=change-me

# --- Telegram (optional) ---
# BOT_TOKEN enables the Telegram channel. ADMIN_CHAT_ID is optional: set it to
# mirror tickets into an operator group. Without a token the dashboard and the
# other channels still work. Owners can also configure channels in Integrations;
# saved settings override these environment defaults.
#
# Group ids are negative. Copy ADMIN_CHAT_ID exactly.
BOT_TOKEN=
ADMIN_CHAT_ID=

# --- Slack (optional — a client writes to you in Slack, DM or shared channel) ---
# Both or neither. A token without a signing secret can send but cannot safely
# receive, and an instance in that state works right up until someone forges an
# event at it, so Slack stays off until both are present.
#
# Create a Slack app, then:
#   OAuth scopes:  chat:write, im:history, channels:history, groups:history
#                  files:write, files:read, users:read  — the last three are
#                  optional; without them, no attachments and no names
#   Event Subscriptions request URL:  https://your-host/slack/events
#   Subscribe the bot to:  message.im, message.channels
# SLACK_BOT_TOKEN=xoxb-
# SLACK_SIGNING_SECRET=
# Public HTTPS origin used to generate the Slack callback URLs in Integrations.
# Does not create a tunnel or change Slack app settings. No path or query string.
# SLACK_PUBLIC_URL=https://support.example.com

# --- AI (optional — if absent, AI features stay off) ---
#
# You do not have to set anything here. Provider, model and key are chosen in
# the dashboard under AI settings, stored in the database, and changed without
# a restart. These variables are the fallback: whatever is set here is used
# until somebody saves a key in the dashboard, which keeps an instance that
# was configured before that existed working untouched.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# A model on your own hardware. No key; this is an address.
# OLLAMA_HOST=http://localhost:11434

# Encrypts API keys before they go in the database, so a backup archive that
# leaves this machine carries ciphertext. Generated into the data directory if
# unset, which is fine — but back that file up SEPARATELY from the archive.
# Without the key, stored credentials, private AI history and document excerpts
# cannot be decrypted. Preserve the original key separately from the backup.
# SECRETS_KEY=

# --- Dashboard ---
# Set to true ONLY when serving over HTTPS (Cloudflare, reverse proxy etc).
# Leave false for localhost-only access.
DASH_COOKIE_SECURE=false

# Optional: how long a dashboard session lives, in seconds. Default 7d.
# DASH_SESSION_MAX_AGE=604800

# Optional: log level for both bot and dashboard
# LOG_LEVEL=INFO

# Optional: signs dashboard session cookies. Leave unset and one is generated
# on first run and stored in the database, so sessions survive restarts. Set it
# explicitly if you run more than one dashboard process against the same data,
# or if you want to invalidate every session by changing it.
# DASH_SECRET_KEY=

# Optional: where the dashboard listens. Defaults to 127.0.0.1:8000.
# Bind 0.0.0.0 only behind a reverse proxy.
# HOST=127.0.0.1
# PORT=8000

# Optional: DEMO_MODE=1 shows a DEMO badge for explicitly seeded local previews.
# Do not set it on a real instance.
# DEMO_MODE=0

# Local attachments from mail, widget and operator uploads are stored here.
# Some channel files remain hosted by their provider. Compose uses a separate
# data volume for local files and pgdata for PostgreSQL; back them up together.
# ATTACHMENTS_DIR=/app/data/attachments

# ---- Email channel ------------------------------------------------------
#
# A mailbox you already have. Nothing is registered with a third party and no
# Spooldesk-specific DNS changes are needed for an already configured mailbox: the dashboard reads the inbox over IMAP once a
# minute and answers over SMTP.
#
# All four are required together. Half a mailbox is the failure worth
# avoiding: SMTP without IMAP answers mail nobody can send it, and IMAP
# without SMTP collects tickets it cannot reply to.
# EMAIL_ADDRESS=support@yoursite.com
# EMAIL_PASSWORD=an-app-password-not-your-real-one
# EMAIL_IMAP_HOST=imap.yoursite.com
# EMAIL_SMTP_HOST=smtp.yoursite.com

# Defaults are 993 (IMAP, implicit TLS) and 587 (SMTP, STARTTLS). Port 465
# for SMTP is understood and switches to implicit TLS.
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_PORT=587

# Only when the login differs from the address, which some hosts insist on.
# EMAIL_LOGIN=support

# What a customer sees in their inbox.
# EMAIL_FROM_NAME=Acme Support
# EMAIL_SUBJECT=Re: your support request

# ---- PostgreSQL --------------------------------------------------------
# A prebuilt release image can be selected without retagging it as latest.
# Set the tag supplied with the release; start with --no-build --pull never.
# SPOOLDESK_IMAGE=spooldesk:rc-VERSION
#
# docker compose up -d starts PostgreSQL and waits for its healthcheck.
# Generate POSTGRES_PASSWORD with scripts/setup.py. The database port is not
# published by the standard Compose stack.
#
# For a direct Python run with a URL, clear POSTGRES_HOST first:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/spooldesk
#
# Existing SQLite files are never deleted or imported implicitly. See
# docs/POSTGRESQL.md for the clean-start and legacy-data migration policy.

# ---- Running behind a reverse proxy -------------------------------------
#
# The domain the production overlay obtains a certificate for. Point its DNS
# A record at this server BEFORE the first start: Let's Encrypt checks it,
# and failed attempts count against a rate limit.
# SPOOLDESK_DOMAIN=help.yoursite.com

# How many proxies sit in front of this process. Leave unset (0) when nothing
# does — X-Forwarded-For is then ignored, which is correct, because a header
# a stranger can send is not evidence of where a request came from and every
# rate limit here is keyed on that answer.
#
# The production overlay sets this to 1 for you. Only change it if you put
# something else in front as well (Cloudflare, a load balancer): the count
# has to match reality, or the limits key on the wrong address.
# TRUSTED_PROXY_HOPS=1
